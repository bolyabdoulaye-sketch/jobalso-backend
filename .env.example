# Copier en .env puis compléter. Ne jamais committer le fichier .env.

# Base de données (DATABASE_URL sert hors Docker ; docker-compose la recalcule)
POSTGRES_USER=jobalso
POSTGRES_PASSWORD=
POSTGRES_DB=jobalso
DATABASE_URL=postgresql://jobalso:motdepasse@localhost:5432/jobalso

# Obligatoire. Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Stockage objet (RustFS / MinIO / S3)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=jobalso-cv
MINIO_SECURE=false

# Emails (Mailpit en local : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@jobalso.com

# Front : liens envoyés par email et origine autorisée (CORS)
FRONTEND_URL=http://localhost:3000
# Plusieurs origines : CORS_ORIGINS=http://localhost:3000,https://app.jobalso.com
CORS_ORIGINS=

RATE_LIMIT_ENABLED=true

PGADMIN_EMAIL=
PGADMIN_PASSWORD=
